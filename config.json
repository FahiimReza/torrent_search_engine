{
  "app": {
    "secret_key": "your-secret-key-change-this-in-production",
    "debug": true,
    "host": "0.0.0.0",
    "port": 5000
  },
  "cache": {
    "timeout_seconds": 300,
    "max_size": 1000
  },
  "search": {
    "max_results_per_source": 20,
    "max_total_results": 100,
    "request_timeout": 15,
    "max_workers": 8
  },
  "tor": {
    "enabled": true,
    "socks_proxy": "socks5h://127.0.0.1:9050",
    "timeout": 30
